# Stage 1 — one VPS. Copy to /opt/ispsolutions/ispsolutions.env (never commit).
# Docker DNS names are correct here because every service shares the compose network.

NODE_ENV=production
APP_ENV=production
HOST=0.0.0.0
PORT=3000
ROLE=web

APP_URL=https://ops.example.co.ke
APP_PUBLIC_URL=https://ops.example.co.ke
TENANT_SUBDOMAIN_BASE=ops.example.co.ke
APP_SECRET=change-me
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=https://ops.example.co.ke
BETTER_AUTH_TRUSTED_ORIGINS=https://ops.example.co.ke
ISPSOLUTIONS_DOMAIN=ops.example.co.ke
ACME_EMAIL=you@example.co.ke
ISPSOLUTIONS_INTERNAL_URL=http://web:3000
ISPSOLUTIONS_URL=http://web:3000
INTERNAL_SERVICE_TOKEN=change-me
ACS_EDGE_TOKEN=change-me
CRON_SECRET=change-me
HEALTHCHECK_TOKEN=

POSTGRES_USER=ispsolutions
POSTGRES_DB=ispsolutions
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://ispsolutions:change-me@postgres:5432/ispsolutions
DATABASE_POOL_MAX=10
DATABASE_SSL_MODE=disable
DATABASE_CONNECT_TIMEOUT_MS=8000

REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0
REDIS_TLS=false

RADIUS_HOST=freeradius
RADIUS_AUTH_PORT=1812
RADIUS_ACCOUNTING_PORT=1813
RADIUS_COA_PORT=3799
RADIUS_DISCONNECT_PORT=3799
RADIUS_SECRET=
ISPSOLUTIONS_SLUG=
RADIUS_API_KEY=

GENIEACS_NBI_URL=http://genieacs:7557
GENIEACS_CWMP_URL=http://genieacs:7547
GENIEACS_NBI_USERNAME=
GENIEACS_NBI_PASSWORD=
GENIEACS_UI_JWT_SECRET=change-me
MONGODB_URL=mongodb://mongo:27017/genieacs
MONGODB_DATABASE=genieacs

ISPSOLUTIONS_AUTO_DEPLOY=0
TRAFFIC_COLLECTION_INTERVAL=30
TRAFFIC_ROUTER_INTERVAL=60
COLLECTOR_ID=default
MIKROTIK_API_TIMEOUT=4000
WIREGUARD_ENDPOINT=
WORKER_CONCURRENCY=2
JOB_QUEUE_NAME=
LOG_LEVEL=info
METRICS_ENABLED=true
