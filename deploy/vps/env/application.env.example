# Application VPS — web, Caddy, Redis, workers.
# Replace private addresses with the WireGuard or provider network IPs of the other VPS servers.

NODE_ENV=production
APP_URL=https://ops.example.co.ke
APP_PUBLIC_URL=https://ops.example.co.ke
TENANT_SUBDOMAIN_BASE=ops.example.co.ke
APP_SECRET=change-me
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=https://ops.example.co.ke
ISPSOLUTIONS_DOMAIN=ops.example.co.ke
ACME_EMAIL=you@example.co.ke
ISPSOLUTIONS_INTERNAL_URL=http://10.200.0.10:3000
INTERNAL_SERVICE_TOKEN=change-me
ACS_EDGE_TOKEN=change-me

DATABASE_URL=postgres://ispsolutions:change-me@10.200.0.20:5432/ispsolutions
DATABASE_POOL_MAX=20
DATABASE_SSL_MODE=require
DATABASE_CONNECT_TIMEOUT_MS=8000

REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0
REDIS_TLS=false

GENIEACS_NBI_URL=http://10.200.0.30:7557
GENIEACS_CWMP_URL=http://10.200.0.30:7547
MONGODB_URL=
RADIUS_HOST=10.200.0.30
RADIUS_AUTH_PORT=1812
RADIUS_ACCOUNTING_PORT=1813
WIREGUARD_ENDPOINT=wg.ispsolutions.co.ke:51820
WIREGUARD_PUBLIC_HOST=wg.ispsolutions.co.ke
WIREGUARD_PUBLIC_PORT=51820
WIREGUARD_HUB_ADDRESS=10.200.0.1
WIREGUARD_NETWORK=10.200.0.0/24
ROUTEROS_API_PORT=8728
ROUTEROS_API_TLS=false
ROUTEROS_HTTPS_CHECK_CERTIFICATE=false
WORKER_CONCURRENCY=2
LOG_LEVEL=info
WEB_BIND=10.200.0.10
REDIS_BIND=127.0.0.1
