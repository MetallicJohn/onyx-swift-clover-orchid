# Traffic collector VPS — snapshots RADIUS sessions via the application API.
NODE_ENV=production
ROLE=collector
SKIP_MIGRATE=1
ISPSOLUTIONS_INTERNAL_URL=http://10.200.0.10:3000
INTERNAL_SERVICE_TOKEN=change-me
TRAFFIC_COLLECTION_INTERVAL=30
TRAFFIC_ROUTER_INTERVAL=60
TRAFFIC_ENABLED=true
COLLECTOR_ID=edge-1
